{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "branchPrefix": "renovate_",
  "reviewers": [
    "team:eng-agent"
  ],
  "prConcurrentLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "golang": {
    "postUpdateOptions": ["goModTidy"],
    "ignorePaths": ["**/mocks/**"]
  }
}
